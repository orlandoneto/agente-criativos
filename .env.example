# Copie para .env e preencha. NUNCA commit o .env.
GEMINI_API_KEY=

# Texto — na conta free preferir lite-latest (2.0/2.5-flash costumam 404)
GEMINI_MODEL=gemini-flash-lite-latest

# Imagem — abordagem A + chaveador
GEMINI_IMAGE_ENABLED=true
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_CHAIN=cloudflare,openrouter,gemini,hf,aihorde,pollinations,pexels,unsplash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODELS=
# OPENROUTER_TEXT_MODELS=  # free text models, comma-separated
AIHORDE_API_KEY=
AIHORDE_CLIENT_AGENT=agente-criativos:1.0:anonymous
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# TLS verificado (padrão true). Só use false em rede com antivírus/MITM conhecido.
GEMINI_SSL_VERIFY=true

# Vídeo slideshow Reels/TikTok (opcional)
# VIDEO_FPS=30
# VIDEO_SEGUNDOS_POR_SLIDE=2.5

# Opcional
# OBSIDIAN_VAULT_PATH=

# FreeLLMAPI dedicado (porta 3003). Sem isto o texto cai para OpenRouter/Gemini.
FREELLMAPI_BASE_URL=http://127.0.0.1:3003/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT=240
FREELLMAPI_CONNECT_TIMEOUT=3
FREELLMAPI_API_KEY=

# Revisão automática (pré-checagem local + IA de visão grátis)
# REVISAO_LIMIAR=7
# REVISAO_TENTATIVAS=2
# REVISAO_PRAZO=240
# REVISAO_GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Reserva de visão: GLM-4.6V-Flash (Z.ai, free). Conta separada do agente-criativos.
ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# REVISAO_ZAI_MODEL=glm-4.6v-flash
